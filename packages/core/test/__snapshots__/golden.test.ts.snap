    .svgm-tick {
      transform-origin: 12px 11.5px;
      transform-box: view-box;
      animation: svgm-tick-scale 1s cubic-bezier(0.42, 0, 0.58, 1) 0.25s 1 both;
    }

    @keyframes svgm-tick-scale {
      0% {
        transform: scale(0);
        animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
      }
      100% {
        transform: scale(1);
        animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
      }
    }
  </style>
