      <stop offset="0" stop-color="#38bdf8" />
      <stop offset="1" stop-color="#1e3a8a" stop-opacity="0.4" />
    </linearGradient>
    <radialGradient id="svgm-gradient-2" gradientUnits="userSpaceOnUse" cx="20" cy="20" r="10" fx="16" fy="18">
      <stop offset="0" stop-color="#fde047" />
      <stop offset="1" stop-color="#f97316" />
    </radialGradient>
    <linearGradient id="svgm-gradient-3" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1" y2="1" gradientTransform="matrix(0 10 -100 0 100 40)">
      <stop offset="0" stop-color="#38bdf8" />
      <stop offset="1" stop-color="#1e3a8a" stop-opacity="0.4" />
    </linearGradient>
  </defs>
  <path class="svgm-backdrop" d="M0 0C33.333 0 66.667 0 100 0C100 16.667 100 33.333 100 50C66.667 50 33.333 50 0 50C0 33.333 0 16.667 0 0Z" fill="url(#svgm-gradient-1)" />
  <path class="svgm-sun-disc" d="M30 20C30 25.523 25.523 30 20 30C14.477 30 10 25.523 10 20C10 14.477 14.477 10 20 10C25.523 10 30 14.477 30 20Z" fill="url(#svgm-gradient-2)" />
  <path class="svgm-banner" d="M0 40C33.333 40 66.667 40 100 40C100 43.333 100 46.667 100 50C66.667 50 33.333 50 0 50C0 46.667 0 43.333 0 40Z" fill="url(#svgm-gradient-3)" />
  <path class="svgm-patterned" d="M60 5C66.667 5 73.333 5 80 5C80 11.667 80 18.333 80 25C73.333 25 66.667 25 60 25C60 18.333 60 11.667 60 5Z" fill="#64748b" />
  <path class="svgm-missing" d="M60 30C66.667 30 73.333 30 80 30C80 33.333 80 36.667 80 40C73.333 40 66.667 40 60 40C60 36.667 60 33.333 60 30Z" fill="none" />
  <path class="svgm-edge" d="M5 45C35 45 65 45 95 45" fill="none" stroke="url(#svgm-gradient-2)" stroke-width="2" stroke-linecap="butt" stroke-linejoin="miter" />
</svg>"
