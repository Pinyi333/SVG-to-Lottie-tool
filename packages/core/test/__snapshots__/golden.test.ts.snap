exports[`morph output stays stable > renders the same CSS 1`] = `
".svgm-tick {
  animation: svgm-tick-morph 1s cubic-bezier(0.42, 0, 0.58, 1) 0.25s 1 both;
}

@keyframes svgm-tick-morph {
  0% {
    d: path("M20 6C16.333 9.667 12.667 13.333 9 17C7.333 15.333 5.667 13.667 4 12");
    animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
  }
  100% {
    d: path("M4 4C6.667 6.667 9.333 9.333 12 12C14.667 14.667 17.333 17.333 20 20");
    animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
  }
}"
`;

