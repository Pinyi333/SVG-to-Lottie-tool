exports[`rotate output stays stable > renders the same CSS 1`] = `
".svgm-tick {
  transform-origin: 12px 11.5px;
  transform-box: view-box;
  animation: svgm-tick-rotate 1s cubic-bezier(0.42, 0, 0.58, 1) 0.25s 1 both;
}

@keyframes svgm-tick-rotate {
  0% {
    transform: rotate(0deg);
    animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
  }
  100% {
    transform: rotate(360deg);
    animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
  }
}"
`;

