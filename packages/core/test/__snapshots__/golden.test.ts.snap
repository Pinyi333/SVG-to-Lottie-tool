exports[`bounce output stays stable > renders the same CSS 1`] = `
".svgm-tick {
  transform-origin: 12px 11.5px;
  transform-box: view-box;
  animation: svgm-tick-bounce 1s cubic-bezier(0.42, 0, 0.58, 1) 0.25s 1 both;
}

@keyframes svgm-tick-bounce {
  0% {
    transform: translateY(0px);
    animation-timing-function: cubic-bezier(0, 0, 0.58, 1);
  }
  23.58% {
    transform: translateY(-2.75px);
    animation-timing-function: cubic-bezier(0.42, 0, 1, 1);
  }
  47.15% {
    transform: translateY(0px);
    animation-timing-function: cubic-bezier(0, 0, 0.58, 1);
  }
  62.97% {
    transform: translateY(-1.2375px);
    animation-timing-function: cubic-bezier(0.42, 0, 1, 1);
  }
  78.78% {
    transform: translateY(0px);
    animation-timing-function: cubic-bezier(0, 0, 0.58, 1);
  }
  89.39% {
    transform: translateY(-0.5569px);
    animation-timing-function: cubic-bezier(0.42, 0, 1, 1);
  }
  100% {
    transform: translateY(0px);
    animation-timing-function: cubic-bezier(0, 0, 0.58, 1);
  }
}"
`;

